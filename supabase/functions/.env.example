# Copy to supabase/functions/.env (git-ignored) and push with:
#   supabase secrets set --env-file supabase/functions/.env
# These live ONLY in Supabase Secrets. Never put them in frontend/ or backend/.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Use ONE of the two sender options:
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Long random string (e.g. `openssl rand -hex 32`). Must match the Vault secret
# "sms_worker_secret" and SMS_WORKER_SECRET in backend/.env.
SMS_WORKER_SECRET=change-me

# Optional: name shown at the start of every SMS (default: CuraClinic)
CLINIC_NAME=CuraClinic
